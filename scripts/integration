#!/usr/bin/env python3
"""Live-scan CLI checks and browser PTY checks; all mutations use owned fixtures."""
import os
from pathlib import Path
import re
import subprocess
import tempfile

binary = Path('target/debug/rcdu').resolve()


def run(*args, env=None, success=True):
    result = subprocess.run([str(binary), *map(str, args)], capture_output=True, timeout=30, env=env)
    assert (result.returncode == 0) == success, (args, result.returncode, result.stderr)
    return result


with tempfile.TemporaryDirectory(prefix='rcdu-integration-') as directory:
    owned = Path(directory)
    root = owned / 'tree'
    root.mkdir()
    (root / 'sub').mkdir()
    (root / 'sub' / 'file').write_bytes(b'hello')
    os.link(root / 'sub' / 'file', root / 'link')
    sparse = root / 'sparse'
    with sparse.open('wb') as file:
        file.truncate(2 * 1024 * 1024)
    unique = [root, root / 'sub', root / 'sub' / 'file', sparse]
    expected = (sum(path.stat().st_blocks * 512 for path in unique), sum(path.stat().st_size for path in unique), 4)
    for workers in [1, 4]:
        result = run('--ignore-config', '--quit-after-scan', '-t', workers, root)
        match = re.search(rb': (\d+) allocated bytes, (\d+) apparent bytes, (\d+) items\n$', result.stdout)
        assert match, result.stdout
        assert tuple(map(int, match.groups())) == expected
    for option in ['-f', '-o', '-O', '-c', '--compress', '--compress-level', '--export-block-size', '--scan-report', '--delete-command']:
        assert b'unknown option' in run('--ignore-config', option, success=False).stderr
    assert b'stdin is not a tty' in run('--ignore-config', root, success=False).stderr

    # rcdu reads only its own configuration namespace, never ncdu's.
    config = owned / 'config'
    (config / 'ncdu').mkdir(parents=True)
    (config / 'ncdu' / 'config').write_text('--invalid-legacy-setting\n')
    env = {**os.environ, 'XDG_CONFIG_HOME': str(config)}
    run('--quit-after-scan', root, env=env)
    (config / 'rcdu').mkdir()
    (config / 'rcdu' / 'config').write_text('--threads 256\n')
    assert b'out of range' in run('--quit-after-scan', root, env=env, success=False).stderr
    run('--ignore-config', '--quit-after-scan', root, env=env)
    (config / 'rcdu' / 'config').write_text('--threads 1\n')
    run('--quit-after-scan', '-t4', root, env=env)

subprocess.run(['scripts/pty-check'], check=True, timeout=90)
print('PASS: live scan sizes, sparse files, hardlinks, worker counts, removed option rejection, rcdu config isolation, browser actions')
