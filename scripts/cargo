#!/usr/bin/env python3
"""Always use half the affinity/cgroup CPU budget, including native builds/tests."""
import os
import sys
from cpu_budget import build_jobs
jobs = build_jobs()
args = sys.argv[1:]
if any(arg == '-j' or arg.startswith('--jobs') or (arg.startswith('-j') and len(arg) > 2) for arg in args):
    sys.exit('scripts/cargo computes jobs; remove the explicit -j/--jobs override')
for key in ('CARGO_BUILD_JOBS', 'NUM_JOBS', 'CMAKE_BUILD_PARALLEL_LEVEL', 'RAYON_NUM_THREADS'):
    os.environ[key] = str(jobs)
os.environ['MAKEFLAGS'] = f'-j{jobs}'
if args and args[0] == 'test' and not any(arg.startswith('--test-threads') for arg in args):
    if '--' not in args:
        args.append('--')
    args.append(f'--test-threads={jobs}')
print(f'cargo: affinity/cgroup budget => {jobs} build jobs', file=sys.stderr)
os.execvp('cargo', ['cargo', *args])
