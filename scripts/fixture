#!/usr/bin/env python3
"""Create a new, owned synthetic metadata workload; never replace an existing directory."""
import argparse
import json
from pathlib import Path
p = argparse.ArgumentParser()
p.add_argument('root', type=Path)
p.add_argument('--files', type=int, default=100000)
p.add_argument('--directories', type=int, default=1024)
a = p.parse_args()
a.root.mkdir(parents=True, exist_ok=False)
for number in range(a.directories):
    (a.root / f'd{number:04}').mkdir()
for number in range(a.files):
    (a.root / f'd{number % a.directories:04}' / f'file-{number:08}').touch()
print(json.dumps({'version': 1, 'kind': 'synthetic-empty-files', 'root': str(a.root.resolve()), 'files': a.files, 'directories': a.directories, 'writes': 'fixture generation only; scans do not read file contents'}))
