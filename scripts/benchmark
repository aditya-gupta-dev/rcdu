#!/usr/bin/env python3
"""Measure live scans across worker counts; compare root totals before timing."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import statistics
import subprocess
import tempfile
from cpu_budget import available_cpus

parser = argparse.ArgumentParser()
parser.add_argument('--root', required=True, type=Path)
parser.add_argument('--candidate', type=Path, default=Path('target/release/rcdu'))
parser.add_argument('--workers', default=None)
parser.add_argument('--runs', type=int, default=5)
parser.add_argument('--label', required=True)
parser.add_argument('--output', type=Path, default=Path('benchmarks/results'))
a = parser.parse_args()
if a.runs < 5:
    parser.error('at least five measured runs required')
cpus = available_cpus()
workers = sorted(set(map(int, a.workers.split(',')))) if a.workers else sorted({1, max(1, cpus // 2), cpus})
if not all(1 <= count <= 255 for count in workers):
    parser.error('worker counts must be 1..255')
exe = a.candidate.resolve()
root = a.root.resolve()
monitor = Path('target/tools/measure').resolve()
if not monitor.exists():
    parser.error('build the monitor first: cc -O2 -Wall -Wextra -Werror scripts/measure.c -o target/tools/measure')
commands = {count: [str(exe), '--ignore-config', '-0', '--quit-after-scan', '-t', str(count), str(root)] for count in workers}
checks = {}
for count, command in commands.items():
    checks[count] = subprocess.check_output(command).decode().strip()
if len(set(checks.values())) != 1:
    raise SystemExit(f'root totals differ across worker counts: {checks}')
records = []
with tempfile.TemporaryDirectory(prefix='rcdu-benchmark-') as directory:
    timing = Path(directory) / 'rusage.json'
    for iteration in range(a.runs):
        order = workers if iteration % 2 == 0 else workers[::-1]
        for count in order:
            result = subprocess.run([str(monitor), str(timing), *commands[count]], capture_output=True)
            if result.returncode:
                raise SystemExit(result.stderr.decode(errors='replace'))
            if result.stdout.decode().strip() != checks[count]:
                raise SystemExit('tree totals changed during measurement')
            measured = json.loads(timing.read_text())
            records.append({**measured, 'workers': count, 'iteration': iteration, 'command': commands[count], 'root_summary': checks[count]})
            print(f't={count} run={iteration + 1}: {measured["wall_seconds"]:.3f}s, {measured["peak_rss_kib"]} KiB', flush=True)
summary = []
for count in workers:
    group = [record for record in records if record['workers'] == count]
    summary.append({'workers': count, 'wall_median': statistics.median(record['wall_seconds'] for record in group), 'rss_median_kib': statistics.median(record['peak_rss_kib'] for record in group)})
environment = {
    'manifest_version': 3, 'label': a.label, 'root': str(root), 'mode': 'live scan',
    'version': subprocess.check_output([str(exe), '--version'], text=True).strip(),
    'artifact_sha256': hashlib.sha256(exe.read_bytes()).hexdigest(),
    'available_cpus': cpus, 'affinity': sorted(os.sched_getaffinity(0)),
    'kernel': platform.release(), 'machine': platform.machine(),
    'cache_state': 'warm after an unmeasured scan for each worker count',
    'validation': 'root totals match across worker counts; this is not a per-entry oracle',
    'rss_unit': 'KiB (Linux wait4 ru_maxrss); native monitor excluded',
}
a.output.mkdir(parents=True, exist_ok=True)
path = a.output / f'{a.label}.json'
with path.open('x') as destination:
    json.dump({'environment': environment, 'observations': records, 'summary': summary}, destination, indent=2)
print(json.dumps(summary, indent=2))
print(path)
