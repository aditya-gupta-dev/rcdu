#!/usr/bin/env python3
"""Five alternating warm-cache observations per setting. Compilation/generation are external."""
import argparse
import hashlib
import json
import os
import platform
import statistics
import subprocess
import tempfile
import time
from pathlib import Path
from cpu_budget import available_cpus
p = argparse.ArgumentParser()
p.add_argument('--root', required=True, type=Path)
p.add_argument('--baseline', type=Path, default=Path('target/baseline/ncdu-2.9.2'))
p.add_argument('--candidate', type=Path, default=Path('target/release/rcdu'))
p.add_argument('--workers', default=None)
p.add_argument('--runs', type=int, default=5)
p.add_argument('--label', required=True)
p.add_argument('--output', type=Path, default=Path('benchmarks/results'))
a = p.parse_args()
if a.runs < 5:
    p.error('at least five measured runs required')
cpus = available_cpus()
workers = sorted(set(map(int, a.workers.split(',')))) if a.workers else sorted(set([1, 2, 4, max(1, cpus // 2), cpus]))
versions = {name: subprocess.check_output([str(exe.resolve()), '--version'], text=True).strip() for name, exe in [('zig', a.baseline), ('rust', a.candidate)]}
meta = {'manifest_version': 1, 'label': a.label, 'root': str(a.root.resolve()), 'cache_state': 'warm after one unmeasured scan; no cache dropping', 'available_cpus': cpus, 'affinity': sorted(os.sched_getaffinity(0)), 'kernel': platform.release(), 'machine': platform.machine(), 'cpu': next((line.split(':',1)[1].strip() for line in Path('/proc/cpuinfo').read_text().splitlines() if line.startswith('model name')), 'unknown'), 'filesystem': subprocess.check_output(['stat','-f','-c','%T',str(a.root)], text=True).strip(), 'storage': subprocess.check_output(['findmnt','-T',str(a.root),'-n','-o','SOURCE,FSTYPE,OPTIONS'], text=True).strip(), 'versions': versions, 'build_flags': 'Rust ordinary Cargo release, portable target; installed distribution Zig artifact (package flags not known)', 'rss_unit': 'KiB (Linux wait4 ru_maxrss)', 'measurement': 'scripts/measure.c fresh native fork/wait4 monitor + CLOCK_MONOTONIC. Only scanner child rusage counted; monitor excluded; same kernel metric as GNU time -v'}
env = os.environ.copy()
env.pop('RAYON_NUM_THREADS', None)
records = []
with tempfile.TemporaryDirectory(prefix='rcdu-benchmark-') as temp:
    temp = Path(temp)
    for count in workers:
        commands = {name: [str(exe.resolve()), '--ignore-config', '-0', '--quit-after-scan', '-t', str(count), str(a.root.resolve())] for name, exe in [('zig', a.baseline), ('rust', a.candidate)]}
        checks = {}
        for name, exe in [('zig', a.baseline), ('rust', a.candidate)]:
            export = temp / f'{name}.json'
            subprocess.run([str(exe.resolve()), '--ignore-config','-0','-t',str(count),'-o',str(export),str(a.root.resolve())], env=env, check=True)
            with export.open('rb') as data:
                normalized = subprocess.check_output(['target/release/examples/normalize'], stdin=data)
            checks[name] = {'sha256': hashlib.sha256(normalized).hexdigest(), 'entries_including_root': len(normalized.splitlines()), 'root_record': normalized.splitlines()[0].decode()}
            subprocess.run(commands[name], env=env, check=True, stdout=subprocess.DEVNULL)
        if checks['zig'] != checks['rust']:
            raise SystemExit(f'correctness mismatch at {count} workers: {checks}')
        for iteration in range(a.runs):
            order = ['zig','rust'] if iteration % 2 == 0 else ['rust','zig']
            for name in order:
                timing = temp / 'rusage.json'
                run = subprocess.run(['target/tools/measure', str(timing), *commands[name]], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
                measured = json.loads(timing.read_text())
                seconds = measured['wall_seconds']
                records.append({**measured,'implementation':name,'workers':count,'iteration':iteration,'command':commands[name],'peak_rss_decimal_mb':measured['peak_rss_kib'] * 1024 / 1e6,'stderr':run.stderr.decode(errors='replace'),'correctness':checks[name],'kernel_rusage':measured})
                if run.returncode:
                    raise SystemExit(run.stderr.decode(errors='replace'))
                print(f'{name} t={count} run={iteration+1}: {seconds:.3f}s, {records[-1]["peak_rss_kib"]} KiB', flush=True)
summary = []
for count in workers:
    for name in ['zig','rust']:
        group = [r for r in records if r['implementation'] == name and r['workers'] == count]
        summary.append({'implementation':name,'workers':count,'wall_median':statistics.median(r['wall_seconds'] for r in group),'wall_range':[min(r['wall_seconds'] for r in group),max(r['wall_seconds'] for r in group)],'rss_median_kib':statistics.median(r['peak_rss_kib'] for r in group),'rss_range_kib':[min(r['peak_rss_kib'] for r in group),max(r['peak_rss_kib'] for r in group)]})
a.output.mkdir(parents=True, exist_ok=True)
path = a.output / f'{a.label}.json'
with path.open('x') as out:
    json.dump({'environment':meta,'observations':records,'summary':summary},out,indent=2)
print(json.dumps(summary,indent=2))
print(path)
