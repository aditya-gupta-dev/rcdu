#!/usr/bin/env python3
"""Alternating warm-cache runs with independent, byte-aware correctness checks."""
import argparse
import hashlib
import json
import os
import platform
import statistics
import subprocess
import tempfile
from pathlib import Path
from cpu_budget import available_cpus

p = argparse.ArgumentParser()
p.add_argument('--root', required=True, type=Path)
p.add_argument('--baseline', type=Path, default=Path('target/baseline/ncdu-source'))
p.add_argument('--candidate', type=Path, default=Path('target/release/rcdu'))
p.add_argument('--baseline-name', default='zig')
p.add_argument('--candidate-name', default='rust')
p.add_argument('--baseline-flags', default='Zig 0.15.2 build --release=fast -Dstrip; portable target; system zstd 1.5.7')
p.add_argument('--candidate-flags', default='Cargo ordinary release; portable target; unwind; bundled zstd 1.5.7')
p.add_argument('--mode', choices=['scan','json','zstd-json','binary'], default='scan')
p.add_argument('--metadata-backend', choices=['fstatat','statx'], default='fstatat')
p.add_argument('--workers', default=None)
p.add_argument('--runs', type=int, default=5)
p.add_argument('--label', required=True)
p.add_argument('--output', type=Path, default=Path('benchmarks/results'))
a = p.parse_args()
if a.runs < 5:
    p.error('at least five measured runs required')
if a.baseline_name == a.candidate_name:
    p.error('implementation names must differ')
cpus = available_cpus()
workers = sorted(set(map(int, a.workers.split(',')))) if a.workers else sorted(set([1,2,4,max(1,cpus//2),cpus]))
if not all(1 <= count <= 255 for count in workers):
    p.error('worker counts must be 1..255')
executables = {a.baseline_name:a.baseline.resolve(), a.candidate_name:a.candidate.resolve()}
names = list(executables)
versions = {name:subprocess.check_output([str(exe),'--version'],text=True).strip() for name,exe in executables.items()}
meta = {
    'manifest_version':2, 'normalization_version':2, 'label':a.label,
    'root':str(a.root.resolve()), 'mode':a.mode, 'metadata_backend':a.metadata_backend,
    'cache_state':'warm after one unmeasured run per implementation/setting; no cache dropping',
    'available_cpus':cpus, 'affinity':sorted(os.sched_getaffinity(0)),
    'kernel':platform.release(), 'machine':platform.machine(),
    'cpu':next((line.split(':',1)[1].strip() for line in Path('/proc/cpuinfo').read_text().splitlines() if line.startswith('model name')), 'unknown'),
    'filesystem':subprocess.check_output(['stat','-f','-c','%T',str(a.root)],text=True).strip(),
    'storage':subprocess.check_output(['findmnt','-T',str(a.root),'-n','-o','SOURCE,FSTYPE,OPTIONS'],text=True).strip(),
    'versions':versions,
    'build_flags':{a.baseline_name:a.baseline_flags,a.candidate_name:a.candidate_flags},
    'artifact_sha256':{name:hashlib.sha256(exe.read_bytes()).hexdigest() for name,exe in executables.items()},
    'rust_toolchain':subprocess.check_output(['rustc','-Vv'],text=True).strip(),
    'rss_unit':'KiB (Linux wait4 ru_maxrss)',
    'measurement':'scripts/measure.c fresh native fork/wait4 + CLOCK_MONOTONIC; scanner child rusage only; monitor excluded',
}
def fingerprint(exported, destination):
    with exported.open('rb') as source, destination.open('wb') as output:
        subprocess.run(['target/release/examples/normalize'],stdin=source,stdout=output,check=True)
    digest=hashlib.sha256()
    counts={'entries_including_root':0,'directories':0,'errors':0,'exclusions':0,'hardlinks':0}
    root_record=None
    with destination.open('rb') as source:
        for line in source:
            digest.update(line)
            if root_record is None: root_record=line.rstrip().decode()
            row=line.rstrip().split(b'\t')
            counts['entries_including_root']+=1
            counts['directories']+=row[1]==b'0'
            counts['errors']+=row[1]==b'-1' or row[10]==b'true'
            counts['exclusions']+=row[1] in [b'-2',b'-3',b'-4']
            counts['hardlinks']+=row[1]==b'3'
    return {'sha256':digest.hexdigest(),**counts,'root_record':root_record}

env = os.environ.copy()
env.pop('RAYON_NUM_THREADS',None)
records = []
with tempfile.TemporaryDirectory(prefix='rcdu-benchmark-') as owned:
    temp = Path(owned)
    for count in workers:
        common = {name:[str(exe),'--ignore-config','-0','-t',str(count)] for name,exe in executables.items()}
        if a.metadata_backend == 'statx':
            common[a.candidate_name] += ['--metadata-backend','statx']
        commands = {}
        for name in names:
            if a.mode == 'scan':
                flags = ['--quit-after-scan']
            else:
                flags = ['-O' if a.mode == 'binary' else '-o', str(temp / f'{name}.export')]
                if a.mode == 'zstd-json': flags += ['-c']
            commands[name] = common[name] + flags + [str(a.root.resolve())]
        checks = {}
        for name in names:
            exported = temp / f'{name}.json'
            subprocess.run(common[name]+['-o',str(exported),str(a.root.resolve())],env=env,check=True)
            checks[name] = fingerprint(exported, temp / f'{name}.normalized')
            subprocess.run(commands[name],env=env,check=True,stdout=subprocess.DEVNULL)
            if a.mode != 'scan':
                converted = temp / f'{name}.converted'
                subprocess.run([str(executables[name]),'--ignore-config','-0','-f',str(temp/f'{name}.export'),'-o',str(converted)],env=env,check=True)
                replay = fingerprint(converted, temp / f'{name}.replayed')
                assert replay == checks[name], f'{name} {a.mode} differs from observed tree'
        if checks[names[0]] != checks[names[1]]:
            raise SystemExit(f'correctness mismatch at {count} workers: {checks}')
        for iteration in range(a.runs):
            order = names if iteration % 2 == 0 else names[::-1]
            for name in order:
                timing = temp/'rusage.json'
                run = subprocess.run(['target/tools/measure',str(timing),*commands[name]],env=env,stdout=subprocess.DEVNULL,stderr=subprocess.PIPE)
                measured = json.loads(timing.read_text())
                records.append({**measured,'implementation':name,'workers':count,'iteration':iteration,'command':commands[name],'peak_rss_decimal_mb':measured['peak_rss_kib']*1024/1e6,'stderr':run.stderr.decode(errors='replace'),'correctness':checks[name]})
                if run.returncode: raise SystemExit(run.stderr.decode(errors='replace'))
                print(f'{name} t={count} run={iteration+1}: {measured["wall_seconds"]:.3f}s, {measured["peak_rss_kib"]} KiB',flush=True)
summary = []
for count in workers:
    for name in names:
        group = [r for r in records if r['implementation']==name and r['workers']==count]
        summary.append({'implementation':name,'workers':count,'wall_median':statistics.median(r['wall_seconds'] for r in group),'wall_range':[min(r['wall_seconds'] for r in group),max(r['wall_seconds'] for r in group)],'rss_median_kib':statistics.median(r['peak_rss_kib'] for r in group),'rss_range_kib':[min(r['peak_rss_kib'] for r in group),max(r['peak_rss_kib'] for r in group)]})
a.output.mkdir(parents=True,exist_ok=True)
path = a.output / f'{a.label}.json'
with path.open('x') as out: json.dump({'environment':meta,'observations':records,'summary':summary},out,indent=2)
print(json.dumps(summary,indent=2))
print(path)
