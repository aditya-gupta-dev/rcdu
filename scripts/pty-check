#!/usr/bin/env python3
"""Check browser actions and terminal restoration on disposable trees and PTYs."""
import fcntl
import os
from pathlib import Path
import pty
import select
import signal
import struct
import subprocess
import tempfile
import termios
import time

binary = Path('target/debug/rcdu').resolve()


def run(root, actions=None, finish='q', options=()):
    master, slave = pty.openpty()
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', 32, 120, 0, 0))
    original = termios.tcgetattr(slave)

    def attach():
        os.setsid()
        fcntl.ioctl(0, termios.TIOCSCTTY, 0)

    process = subprocess.Popen(
        [str(binary), '--ignore-config', '-t4', *options, str(root)],
        stdin=slave, stdout=slave, stderr=slave, preexec_fn=attach,
        env={**os.environ, 'TERM': 'xterm-256color'},
    )
    seen = bytearray()

    def expect(marker, repeat=None):
        deadline = time.monotonic() + 10
        last_send = 0
        while not (marker() if callable(marker) else marker in seen):
            if time.monotonic() > deadline:
                raise RuntimeError(f'PTY did not show {marker!r}; exit={process.poll()}; tail={bytes(seen[-500:])!r}')
            if repeat and time.monotonic() - last_send > .2:
                os.write(master, repeat)
                last_send = time.monotonic()
            if select.select([master], [], [], .1)[0]:
                seen.extend(os.read(master, 65536))
        seen.clear()

    def send(keys):
        os.write(master, keys)

    try:
        expect(b'Total disk usage:')
        if actions:
            actions(send, expect)
        else:
            send(b'?')
            expect(b'rcdu help')
            send(b'2')
            expect(b'Error reading directory')
            send(b'q')
            send(b'i')
            expect(b'Item info')
            send(b'i')
            fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', 24, 80, 0, 0))
            process.send_signal(signal.SIGWINCH)
            time.sleep(.15)
        if finish == 'q':
            send(b'q')
        else:
            process.send_signal(signal.SIGTERM)
        code = process.wait(timeout=10)
        if code != (0 if finish == 'q' else 1):
            raise RuntimeError(f'wrong exit {code}')
        if termios.tcgetattr(slave) != original:
            raise RuntimeError('terminal attributes not restored')
    finally:
        if process.poll() is None:
            process.kill()
            process.wait()
        os.close(master)
        os.close(slave)


def delete_with_confirmation(target):
    def actions(send, expect):
        send(b'D')
        expect(b'Confirm deletion')
        send(b'y')
        expect(lambda: not target.exists())
        # Wait for the browser to handle another key before sending quit.
        expect(b'rcdu help', repeat=b'?')
        send(b'q')
    return actions


def cancel_deletion(send, expect):
    send(b'D')
    expect(b'Confirm deletion')
    send(b'\r')


def readonly_delete(send, expect):
    send(b'D')
    expect(b'Deletion is disabled')
    send(b' ')


with tempfile.TemporaryDirectory(prefix='rcdu-pty-') as directory:
    owned = Path(directory)
    root = owned / 'navigation'
    root.mkdir()
    (root / 'sub').mkdir()
    (root / 'sub' / 'file').write_bytes(b'data')
    (root / 'other').write_bytes(b'other')
    for finish in ['q', 'signal']:
        run(root, finish=finish)

    root = owned / 'file-deletion'
    root.mkdir()
    target = root / 'only-file'
    target.write_bytes(b'delete fixture')
    run(root, cancel_deletion)
    assert target.exists(), 'Enter must cancel deletion'
    run(root, readonly_delete, options=['-r'])
    assert target.exists(), 'readonly must prevent D deletion'
    run(root, delete_with_confirmation(target))
    assert not target.exists(), 'D must delete the selected file'

    root = owned / 'directory-deletion'
    root.mkdir()
    target = root / 'only-directory'
    (target / 'nested').mkdir(parents=True)
    (target / 'nested' / 'file').write_bytes(b'nested contents')
    outside = owned / 'outside-file'
    outside.write_bytes(b'keep')
    (target / 'outside-link').symlink_to(outside)
    run(root, delete_with_confirmation(target))
    assert not target.exists(), 'D must delete the selected nonempty directory'
    assert outside.read_bytes() == b'keep', 'deletion must not follow symlinks'

    root = owned / 'immediate-deletion'
    root.mkdir()
    target = root / 'only-file'
    target.write_bytes(b'delete fixture')

    def immediate(send, expect):
        send(b'D')
        expect(lambda: not target.exists())
        expect(b'rcdu help', repeat=b'?')
        send(b'q')

    run(root, immediate, options=['--no-confirm-delete'])
    assert not target.exists(), '--no-confirm-delete must delete immediately'

    root = owned / 'partial-deletion'
    root.mkdir()
    target = root / 'directory'
    target.mkdir()
    observed = target / 'observed'
    observed.write_bytes(b'old')
    unseen = target / 'created-after-scan'

    def partial(send, expect):
        unseen.write_bytes(b'keep')
        send(b'D')
        expect(b'Confirm deletion')
        send(b'y')
        expect(b'Deletion error')
        send(b'a')
        expect(b'Selected item remains')
        send(b' ')

    run(root, partial)
    assert target.exists(), 'a partly deleted directory must remain visible'
    assert unseen.read_bytes() == b'keep', 'new content must not be deleted'
    assert not observed.exists(), 'successful unlinks must remain deleted'

print('PASS: navigation/help/details/resize/quit/SIGTERM; D file and directory deletion; confirmation cancel; readonly; partial deletion; symlink preservation; terminal restoration')
